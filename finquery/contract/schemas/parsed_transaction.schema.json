{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ParsedTransaction",
  "type": "object",
  "properties": {
    "date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "description": {
      "type": "string"
    },
    "debit": {
      "type": "number",
      "minimum": 0
    },
    "credit": {
      "type": "number",
      "minimum": 0
    },
    "balance": {
      "type": ["number", "null"]
    },
    "category": {
      "type": "string"
    },
    "bank": {
      "type": "string"
    }
  },
  "required": ["date", "description", "debit", "credit", "balance", "category", "bank"]
}
